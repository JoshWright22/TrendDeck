{
  "name": "trenddeck",
  "productName": "TrendDeck",
  "version": "0.3.0-beta.2",
  "description": "Desktop marketing app for creators. One workspace per brand, every site logged in.",
  "license": "MIT",
  "author": "Josh Wright",
  "repository": {
    "type": "git",
    "url": "https://github.com/JoshWright22/TrendDeck.git"
  },
  "main": "./out/main/boot.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test:gateway": "esbuild scripts/gateway-test.ts --bundle --platform=node --format=esm --outfile=out/test/gateway-test.mjs --log-level=warning && node out/test/gateway-test.mjs",
    "postinstall": "install-electron"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.311",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/inter-tight": "^5.3.0",
    "@ghostery/adblocker": "^2.20.1",
    "@ghostery/adblocker-electron": "^2.20.1",
    "electron-updater": "^6.8.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.7.0",
    "electron-vite": "^5.0.0",
    "typescript": "~5.9",
    "vite": "^7.3.7"
  }
}
